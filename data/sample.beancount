;; Catallax sample ledger — dummy data for local development.
;; 18 months: 2025-01 through 2026-06. EUR/USD, stocks, crypto.
;; Swap to a real ledger via BEANCOUNT_FILE in .env.

option "title" "Catallax Sample Ledger"
option "operating_currency" "EUR"
option "operating_currency" "USD"

;; ─── Commodities ────────────────────────────────────────────
2020-01-01 commodity EUR
2020-01-01 commodity USD
2020-01-01 commodity AAPL
2020-01-01 commodity MSFT
2020-01-01 commodity VWCE
2020-01-01 commodity BTC
2020-01-01 commodity ETH
2020-01-01 commodity SOL

;; ─── Accounts ───────────────────────────────────────────────
2020-01-01 open Equity:Opening-Balances
2020-01-01 open Assets:EU:Bank:Checking          EUR
2020-01-01 open Assets:EU:Bank:Savings           EUR
2020-01-01 open Assets:US:Broker:Cash            USD
2020-01-01 open Assets:US:Broker:Positions
2020-01-01 open Assets:Crypto
2020-01-01 open Income:Salary                    EUR
2020-01-01 open Income:Dividends                 USD
2020-01-01 open Income:CapitalGains              USD
2020-01-01 open Expenses:Rent                    EUR
2020-01-01 open Expenses:Groceries               EUR
2020-01-01 open Expenses:Utilities               EUR
2020-01-01 open Expenses:Dining                  EUR
2020-01-01 open Expenses:Transport               EUR
2020-01-01 open Expenses:Subscriptions           EUR

