# Environment for the hosted demo stack. Copy to the stack dir as `.env` (mode 600).
# Demo values only: no API keys, no real credentials, no private hostnames.
# Generate throw-away passwords, e.g.:  openssl rand -hex 16

POSTGRES_USER=catallax_demo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=catallax_demo
REDIS_PASSWORD=change-me

# Address the LAN port binds to (the edge proxy reaches the demo here).
# Must be the LAN interface address, never 0.0.0.0 (the preflight refuses it).
DEMO_BIND_ADDR=127.0.0.1
DEMO_PORT=8190
# CIDR of the edge proxy (Traefik) as nginx sees it. nginx honours Cf-Connecting-Ip
# for the rate-limit key only from this peer; everyone else is keyed on their own
# address. Use the narrowest range (a /32 or the proxy's docker/LAN subnet), never /0.
# The Traefik template takes the cloudflared source as CLOUDFLARED_SOURCE at render time.
DEMO_TRUSTED_PROXY=127.0.0.1/32
# Free /24 for the stack network (check `docker network inspect` on the host)
DEMO_SUBNET=172.16.7.0/24

# Pinned by compose.demo.yml as well; repeated here so the file documents the contract.
DEMO_MODE=true
LLM_PROVIDER=noop
SHARE_PASSPHRASE=
# Longest-lived copy of a quote (the writer, demo-warm, and the reader share it).
QUOTE_STALE_TTL_SECONDS=172800
# File OUTSIDE this repo, one regex per line, of private host/network markers the
# preflight must not find in the rendered config. Required (fail closed).
DEMO_DENY_MARKERS_FILE=/etc/catallax-demo/deny-markers.txt
# Persona symbols are warmed by default; override with a comma-separated list.
# DEMO_WARM_SYMBOLS=
