# Traefik dynamic file for the hosted demo (DEMO-SPEC §1-§3).
# Render with envsubst, restricted to the four placeholders:
#   HOSTNAME=demo.example.org BACKEND_URL=http://demo-host.example:8190 EDGE_CHAIN=public-chain@file \
#   CLOUDFLARED_SOURCE=203.0.113.10/32 \
#     envsubst '${HOSTNAME} ${BACKEND_URL} ${EDGE_CHAIN} ${CLOUDFLARED_SOURCE}' < traefik-catallax-demo.yml.tmpl > catallax-demo.yml
#   HOSTNAME    public host name of the demo
#   BACKEND_URL URL of the demo nginx (LAN address + DEMO_PORT); never a public address
#   EDGE_CHAIN  name of your existing middleware chain (security headers, HSTS, CrowdSec)
#   CLOUDFLARED_SOURCE  CIDR of the cloudflared connector's source address as Traefik sees it.
#               Only that peer may use these routers (ipAllowList), so Cf-Connecting-Ip can
#               only have been set by Cloudflare.
#
# Three routers on one host. Higher priority wins:
#   30  /api/*  GET|HEAD|OPTIONS   -> backend, API rate limit
#   20  /*      GET|HEAD|OPTIONS   -> backend, static rate limit
#    1  anything else (POST, PUT, ...) -> rewritten to /__405, answered 405 by the demo nginx
# Both rate limiters key on Cf-Connecting-Ip (Cloudflare's client address). The
# SPA preloads many chunks on first load, so the static burst is large; do not
# swap in a shared, smaller limiter.
http:
  routers:
    catallax-demo-api:
      rule: "Host(`${HOSTNAME}`) && PathPrefix(`/api/`) && (Method(`GET`) || Method(`HEAD`) || Method(`OPTIONS`))"
      priority: 30
      service: catallax-demo
      middlewares: ["catallax-demo-cloudflared-only", "catallax-demo-ratelimit-api", "${EDGE_CHAIN}"]
    catallax-demo-static:
      rule: "Host(`${HOSTNAME}`) && (Method(`GET`) || Method(`HEAD`) || Method(`OPTIONS`))"
      priority: 20
      service: catallax-demo
      middlewares: ["catallax-demo-cloudflared-only", "catallax-demo-ratelimit-static", "${EDGE_CHAIN}"]
    catallax-demo-405:
      rule: "Host(`${HOSTNAME}`)"
      priority: 1
      service: catallax-demo
      middlewares: ["catallax-demo-cloudflared-only", "catallax-demo-to-405", "${EDGE_CHAIN}"]

  middlewares:
    catallax-demo-cloudflared-only:
      ipAllowList:
        sourceRange:
          - "${CLOUDFLARED_SOURCE}"
    catallax-demo-ratelimit-api:
      rateLimit:
        average: 10
        burst: 40
        period: 1s
        sourceCriterion:
          requestHeaderName: Cf-Connecting-Ip
    catallax-demo-ratelimit-static:
      rateLimit:
        average: 100
        burst: 400
        period: 1s
        sourceCriterion:
          requestHeaderName: Cf-Connecting-Ip
    # Non-read methods never reach the app: the demo nginx answers /__405 with 405.
    catallax-demo-to-405:
      replacePath:
        path: /__405

  services:
    catallax-demo:
      loadBalancer:
        servers:
          - url: "${BACKEND_URL}"
        passHostHeader: true
