[Unit]
Description=Catallax demo cache warm job (the only upstream caller)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Replace @STACK_DIR@ with the demo clone, e.g. via: sed "s|@STACK_DIR@|$PWD|g"
WorkingDirectory=@STACK_DIR@
# Takes the same lock as reset-demo.sh (never overlaps with the nightly reset), runs the warm,
# then stops the openbb-data sidecar.
ExecStart=@STACK_DIR@/deploy/demo/warm-demo.sh
TimeoutStartSec=10min
