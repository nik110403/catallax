# Copy to .env and adjust. Dummy values below are for a local, loopback-only stack.

# Required
POSTGRES_USER=catallax
POSTGRES_PASSWORD=change-me
POSTGRES_DB=catallax
REDIS_PASSWORD=change-me

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Ledger and portfolio source
BEANCOUNT_FILE=/data/ledger/main.bean
FAVA_BASE_URL=http://fava:5001/fava
REPORTING_CURRENCY=EUR
CASH_CURRENCIES=EUR,USD,GBP
WEALTHFOLIO_NETWORTH_URL=http://stub-exporter:8089
WEALTHFOLIO_CACHE_TTL_SECONDS=300
LEDGER_CACHE_TTL_SECONDS=120
PORTFOLIO_COMMODITIES=

# Demo, access and identity
DEMO_MODE=false
OWNER_NAME=
SHARE_PASSPHRASE=
SHARE_SESSION_DAYS=30
SHARE_COOKIE_SECURE=false

# AI features off
LLM_PROVIDER=noop
COCKPIT_ENABLED=false

# Locale
TZ=UTC
ALERTS_QUIET_HOURS=22-07 UTC

# Tax and cost assumptions (configurable; 0 = not modelled)
ADVISOR_TAX_RATE=0
ADVISOR_LOSS_OFFSET_FACTOR=0
ADVISOR_DCA_BASE=0
ADVISOR_LIFE_FLOOR_MULTIPLIER=0
ADVISOR_ENABLED=true

# Reports
REPORT_PACK_ENABLED=true
REPORT_PACK_TICK_INTERVAL_SECONDS=300
NOTES_EXPORT_DIR=/data/reports/notes
NOTES_ACCOUNT_NAMES=
NOTES_PRIVACY_SCAN_STRICT=true

# Market data (public sources, no keys required)
PRICE_SOURCE_DEFAULT=yfinance
PRICE_FALLBACK_CHAIN_EQUITY=yfinance,stooq
PRICE_FALLBACK_CHAIN_CRYPTO=coingecko
YFINANCE_SYMBOL_ALIASES=
OPENBB_API_URL=http://openbb-data:6900
OPENBB_FRED_API_KEY=

# Events (opt-in)
EVENTS_ENABLED=false
SEC_EDGAR_USER_AGENT=
ALERTS_NTFY_URL=
ALERTS_NTFY_TOKEN=

# Compose
NGINX_BIND_ADDR=127.0.0.1
NGINX_HOST_PORT=8090
